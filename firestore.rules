rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Kullanıcı sadece profil alanlarını yazabilir. Kota (freeQuestionsLeft) ve
      // isProUser alanlarını SADECE sunucu (Admin SDK) değiştirebilir.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['goal', 'dailyHours', 'netHistory'])
        && (!('netHistory' in request.resource.data) || request.resource.data.netHistory.size() <= 60);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goal', 'dailyHours', 'netHistory'])
        && (!('netHistory' in request.resource.data) || request.resource.data.netHistory.size() <= 60);

      // Sunucunun yazdığı veriler: istemci SADECE okur
      match /questions/{id}    { allow read: if isOwner(uid); allow write: if false; }
      match /analyses/{id}     { allow read: if isOwner(uid); allow write: if false; }
      match /weaknesses/{id}   { allow read: if isOwner(uid); allow write: if false; }
      match /weeklyPlans/{id}  { allow read: if isOwner(uid); allow write: if false; }
      match /docSync/{id}      { allow read: if isOwner(uid); allow write: if false; }
      // syncedImages: kural yok -> istemciye tamamen kapalı
    }

    // googleLinks (şifreli refresh token) dahil her şey varsayılan olarak kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
